# =============================================================================
# 阿里云 · 开发版环境模板
# 复制到服务器：/opt/zhida/.env  （或仓库内 zhida/.env）
# 切勿提交真实密钥
# =============================================================================

# ─── LLM（开发版可先用 Qwen / DeepSeek 其一）───────────────────────────────
LLM_PROVIDER=qwen
LLM_PROFILE=personal
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2

QWEN_PERSONAL_API_KEY=替换为百炼Key
QWEN_PERSONAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PERSONAL_MODEL=qwen3.8-flash

DEEPSEEK_PERSONAL_API_KEY=
DEEPSEEK_OFFICE_API_KEY=
DEEPSEEK_OFFICE_BASE_URL=

# 成本估算（Qwen Flash）
LLM_INPUT_CNY_PER_1M=0.8
LLM_OUTPUT_CNY_PER_1M=2.7
LLM_WALLET_PERIOD=month
LLM_WALLET_QWEN_BUDGET_CNY=39
LLM_WALLET_QWEN_INPUT_CNY_PER_1M=0.8
LLM_WALLET_QWEN_OUTPUT_CNY_PER_1M=2.7
TOKEN_PLAN_ENABLED=true
TOKEN_PLAN_NAME=Lite
TOKEN_PLAN_MONTHLY_CREDITS=20000

# ─── MySQL（建议本机或同 VPC RDS）──────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zhida
MYSQL_PASSWORD=替换为强密码
MYSQL_DATABASE=ai_work_zd
MYSQL_CHARSET=utf8mb4
# 与上面一致即可；密码含特殊字符请做 URL 编码
DATABASE_URL=mysql+pymysql://zhida:替换为强密码@127.0.0.1:3306/ai_work_zd?charset=utf8mb4

# ─── API（开发版）───────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=7102
# 明确是开发版：允许开发登录 / 一键会员；正式上线再改 prod
APP_ENV=dev
AUTH_DEV_MODE=true
# 开发版可用 *；对外入口 https://instockdetail.com/ai_work/xuexi
CORS_ORIGINS=*

# ─── 微信（开发版也建议填真实 AppID/Secret，方便真机 wx.login）────────────
WX_APPID=wx335532634164aa43
WX_SECRET=替换为微信后台Secret
JWT_SECRET=替换为至少16位随机串-仅开发机
JWT_EXPIRE_DAYS=30

# ─── 运营看板 /ops ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=替换为看板密码
ADMIN_TOKEN=
