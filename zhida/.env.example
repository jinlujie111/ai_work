# =============================================================================
# zhida/.env —— 仅服务端环境与密钥（勿提交；小程序读不到此文件）
# 小程序公开配置请改：zhida/wx/utils/config.js
# =============================================================================

# ─── LLM ────────────────────────────────────────────────────────────────────
# deepseek / minimax / qwen（qwen 亦可用 dashscope / aliyun）
LLM_PROVIDER=deepseek
LLM_PROFILE=office
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

DEEPSEEK_PERSONAL_API_KEY=
DEEPSEEK_PERSONAL_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_PERSONAL_MODEL=deepseek-chat

DEEPSEEK_OFFICE_API_KEY=
DEEPSEEK_OFFICE_BASE_URL=
DEEPSEEK_OFFICE_MODEL=

MINIMAX_PERSONAL_API_KEY=
MINIMAX_PERSONAL_BASE_URL=https://api.minimax.cn/v1
MINIMAX_PERSONAL_MODEL=MiniMax-M3.1-Flash

# 阿里云百炼 DashScope（OpenAI 兼容）；默认 Qwen3.8-Flash
QWEN_PERSONAL_API_KEY=
QWEN_PERSONAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PERSONAL_MODEL=qwen3.8-flash
# 切到 Qwen 后建议同步运营成本估算（元/百万 token）：
# LLM_INPUT_CNY_PER_1M=0.8
# LLM_OUTPUT_CNY_PER_1M=2.7
# Token Plan 容量监控（Lite=20000 Credits）
TOKEN_PLAN_ENABLED=true
TOKEN_PLAN_NAME=Lite
TOKEN_PLAN_MONTHLY_CREDITS=20000
TOKEN_PLAN_CREDITS_PER_LIST_CNY=81
TOKEN_PLAN_WARN_RATIO=0.7
TOKEN_PLAN_CRITICAL_RATIO=0.9
# 各大模型钱包预算（元）；0=只展示消耗
LLM_WALLET_PERIOD=month
LLM_WALLET_BURN_LOOKBACK_DAYS=7
LLM_WALLET_DEEPSEEK_BUDGET_CNY=100
LLM_WALLET_QWEN_BUDGET_CNY=39
LLM_WALLET_MINIMAX_BUDGET_CNY=50
LLM_WALLET_QWEN_INPUT_CNY_PER_1M=0.8
LLM_WALLET_QWEN_OUTPUT_CNY_PER_1M=2.7

# ─── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_work_zd
MYSQL_CHARSET=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ai_work_zd?charset=utf8mb4

# ─── API 服务 ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# dev | prod；prod 启动会校验 JWT / 微信 / CORS，并禁用开发登录与一键会员
APP_ENV=dev
# 逗号分隔；本地可用 *；prod 必须写显式域名（不可为 *）
CORS_ORIGINS=*

# ─── 微信小程序（服务端登录用；AppID 公开，Secret 保密）────────────────────
WX_APPID=
WX_SECRET=
AUTH_DEV_MODE=true
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=30

# ─── 生产必填清单（APP_ENV=prod）────────────────────────────────────────────
# APP_ENV=prod
# AUTH_DEV_MODE=false
# JWT_SECRET=<至少 16 位强随机串，勿用 change-me / zhida-dev-secret>
# WX_APPID=...
# WX_SECRET=...
# CORS_ORIGINS=https://your.cdn.example
