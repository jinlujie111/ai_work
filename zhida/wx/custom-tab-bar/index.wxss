.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(16, 20, 22, 0.94);
  border-top: 1rpx solid rgba(232, 238, 236, 0.06);
  box-sizing: border-box;
  backdrop-filter: blur(20px);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: #6f7f7d;
}

.tab--on {
  color: #7ec4c0;
}

.tab__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7ec4c0;
  margin-bottom: 8rpx;
}

.tab__text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}
