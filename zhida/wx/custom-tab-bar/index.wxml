<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab--on' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bind:tap="onSwitch"
  >
    <view class="tab__dot" wx:if="{{selected === index}}"></view>
    <text class="tab__text">{{item.text}}</text>
  </view>
</view>
