.hero {
  margin-bottom: 32rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero .zd-title {
  margin-bottom: 0;
}

.chip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--accent);
  padding: 6rpx 0;
  border-bottom: 2rpx solid var(--accent);
}

.area {
  width: 100%;
  min-height: 220rpx;
  padding: 8rpx 0 24rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid var(--border);
  border-radius: 0;
  font-size: 30rpx;
  color: var(--ink-1);
  margin-bottom: 24rpx;
}

.field {
  margin: 28rpx 0;
}

.field__label {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.input {
  padding: 16rpx 0;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid var(--border);
  border-radius: 0;
  font-size: 28rpx;
}

.warn {
  margin-top: 12rpx;
  color: var(--warn);
  font-size: 24rpx;
}

.tip {
  margin: 16rpx 0 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 6rpx 0;
  margin-right: 20rpx;
  border-bottom: 2rpx solid var(--accent);
}

.mod-line {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}

.mod-line__top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.mod-line__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
}

.mod-line__diff {
  font-size: 22rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.line {
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.45;
  border-bottom: 1rpx solid rgba(16, 38, 38, 0.05);
}

.line__strong {
  color: var(--ink-1);
  font-weight: 500;
}

.stream-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(8, 12, 14, 0.72);
}

.stream-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(165deg, rgba(28, 38, 40, 0.98), rgba(18, 24, 26, 0.98));
  border: 1rpx solid rgba(126, 196, 192, 0.18);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
}

.stream-modal__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 16rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  background: rgba(126, 196, 192, 0.16);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.stream-modal__title {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--ink-1);
  line-height: 1.4;
  margin-bottom: 28rpx;
  min-height: 88rpx;
}

.stream-modal__bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.1);
  overflow: hidden;
  margin-bottom: 16rpx;
}

.stream-modal__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(126, 196, 192, 0.45), var(--accent));
  transition: width 0.25s ease;
}

.stream-modal__meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--accent);
  margin-bottom: 20rpx;
}

.stream-modal__logs {
  max-height: 220rpx;
  overflow: hidden;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.22);
  margin-bottom: 18rpx;
}

.stream-modal__log {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.55;
  padding: 2rpx 0;
}



