<view class="page page--plain create">
  <view class="hero">
    <view class="zd-title">学习目标</view>
    <view class="chip" wx:if="{{profileMinutes}}" bind:tap="onOpenMine">每日 {{profileMinutes}} 分</view>
  </view>

  <textarea
    class="area"
    maxlength="500"
    placeholder="我想学……"
    value="{{rawText}}"
    bindinput="onInput"
    auto-height
    disabled="{{loading}}"
  />
  <view class="voice-row">
    <button
      class="zd-btn zd-btn--ghost voice-btn {{recording ? 'voice-btn--on' : ''}}"
      bind:touchstart="onVoiceStart"
      bind:touchend="onVoiceEnd"
      bind:touchcancel="onVoiceEnd"
      disabled="{{loading}}"
    >{{recording ? '松手结束' : '按住说话'}}</button>
  </view>

  <view class="field">
    <view class="field__label">当前基础</view>
    <input class="input" placeholder="" value="{{baseline}}" bindinput="onBaseline" disabled="{{loading}}" />
  </view>

  <button class="zd-btn zd-btn--primary zd-btn--block" bind:tap="onGenerate" loading="{{loading}}" disabled="{{loading}}">生成草案</button>

  <view class="stream-mask" wx:if="{{loading}}" catchtouchmove="noop">
    <view class="stream-modal">
      <view class="stream-modal__badge">AI</view>
      <view class="stream-modal__title">{{streamMessage || 'AI 解析中…'}}</view>
      <view class="stream-modal__bar">
        <view class="stream-modal__fill" style="width: {{streamPct}}%;"></view>
      </view>
      <view class="stream-modal__meta">
        <text>{{streamPct}}%</text>
        <text wx:if="{{streamChars}}">已生成 {{streamChars}} 字</text>
      </view>
      <view class="stream-modal__logs" wx:if="{{streamLogs.length}}">
        <view class="stream-modal__log" wx:for="{{streamLogs}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
  </view>
</view>
