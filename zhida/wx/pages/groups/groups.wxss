.hero {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.actions {
  margin-bottom: 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border);
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
  margin-bottom: 6rpx;
}

.row__go {
  color: var(--accent);
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty {
  padding: 24rpx 0;
}
