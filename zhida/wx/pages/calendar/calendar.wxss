@import "../../styles/task-sheet.wxss";

.cal {
  padding: 0;
  padding-bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 140rpx);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.month {
  padding: 12rpx 28rpx 8rpx;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav__title {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -0.02em;
  color: var(--ink-1);
}

.nav__btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--ink-2);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
}

.weekdays {
  display: flex;
  padding: 0 8rpx 12rpx;
}

.wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 0 12rpx;
}

.cell {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
}

.cell--pad {
  opacity: 0.18;
}

.cell__d {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-1);
  border-radius: 50%;
}

.cell--today .cell__d {
  box-shadow: inset 0 0 0 2rpx rgba(126, 196, 192, 0.55);
  color: var(--accent);
  font-weight: 600;
}

.cell--on .cell__d {
  background: var(--accent);
  color: var(--on-accent);
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(126, 196, 192, 0.28);
}

.dot {
  position: absolute;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-2);
}

.sheet {
  flex: 1;
  margin-top: 8rpx;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 12rpx 28rpx 24rpx;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.28);
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
}

.sheet__grip {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.12);
  margin: 4rpx auto 18rpx;
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tag {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  color: var(--ink-2);
  font-size: 22rpx;
  display: flex;
  align-items: center;
}

.sheet__date {
  font-size: 22rpx;
  color: var(--ink-3);
}

.sheet__body {
  flex: 1;
  max-height: 520rpx;
}

.task {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 22rpx 0 22rpx 12rpx;
  border-bottom: 1rpx solid var(--border);
}

.task:last-child {
  border-bottom: none;
}

.rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: linear-gradient(180deg, transparent, rgba(126, 196, 192, 0.35), transparent);
}

.check {
  width: 48rpx;
  height: 48rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(232, 238, 236, 0.35);
  box-sizing: border-box;
  flex-shrink: 0;
}

.check--on {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: inset 0 0 0 8rpx var(--bg);
}

.task__body {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.task__cat {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  font-size: 20rpx;
  color: var(--ink-3);
  margin-bottom: 4rpx;
}

.prio-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  background: var(--panel-2);
  color: var(--ink-3);
}

.prio-tag--high {
  background: rgba(126, 196, 192, 0.22);
  color: var(--accent);
}

.prio-tag--low {
  opacity: 0.7;
}

.task__name {
  font-size: 32rpx;
  font-weight: 560;
  color: var(--ink-1);
  line-height: 1.35;
}

.task--done {
  opacity: 0.45;
}

.task--done .task__name {
  text-decoration: line-through;
}

.task__mins {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.sheet__sum {
  padding: 18rpx 0 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-3);
}

.void {
  padding: 64rpx 12rpx;
  text-align: center;
}

.void__orb {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(126, 196, 192, 0.3), transparent 65%),
    var(--panel-2);
}

.void__title {
  font-size: 26rpx;
  color: var(--ink-3);
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 28rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 56rpx;
  font-weight: 300;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(126, 196, 192, 0.28);
  z-index: 30;
}

