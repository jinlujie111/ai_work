<view class="page cal">
  <view class="month">
    <view class="nav">
      <text class="nav__btn" bind:tap="onPrev">‹</text>
      <view class="nav__title">{{monthLabel}}</view>
      <text class="nav__btn" bind:tap="onNext">›</text>
    </view>

    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="wd">{{item}}</text>
    </view>

    <view class="grid">
      <view
        class="cell {{item.pad ? 'cell--pad' : ''}} {{item.date === selected ? 'cell--on' : ''}} {{item.date === today && item.date !== selected ? 'cell--today' : ''}}"
        wx:for="{{cells}}"
        wx:key="key"
        data-date="{{item.date}}"
        bind:tap="onSelect"
      >
        <text class="cell__d">{{item.day}}</text>
        <view class="dot" wx:if="{{item.count && item.date !== selected}}"></view>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view class="sheet__left">
        <view class="badge">{{dayCount}}</view>
        <view class="tag">你的任务</view>
      </view>
      <view class="sheet__date">{{selectedLabel}}</view>
    </view>

    <scroll-view scroll-y class="sheet__body">
      <block wx:if="{{dayItems.length}}">
        <view
          class="task {{item.status === 'done' ? 'task--done' : ''}}"
          wx:for="{{dayItems}}"
          wx:key="id"
        >
          <view class="rail"></view>
          <view
            class="check {{item.status === 'done' ? 'check--on' : ''}}"
            data-id="{{item.id}}"
            catch:tap="onToggle"
          ></view>
          <view class="task__body" data-id="{{item.id}}" bind:tap="onOpenTask">
            <view class="task__cat">
              <text>{{item.goalTitle || '目标'}}</text>
              <text class="prio-tag prio-tag--{{item.priority}}" wx:if="{{item.priorityLabel}}">{{item.priorityLabel}}</text>
            </view>
            <view class="task__name">{{item.name}}</view>
            <view class="task__mins" wx:if="{{!item.isInbox}}">
              <text wx:if="{{item.stageNo}}">第 {{item.stageNo}}/{{item.stageTotal}} 阶段 · </text>
              {{item.estimatedMinutes}} 分
            </view>
            <view class="task__mins" wx:else>快速待办</view>
          </view>
        </view>
        <view class="sheet__sum">合计 {{dayMinutes}} 分</view>
      </block>
      <view class="void" wx:else>
        <view class="void__orb"></view>
        <view class="void__title">这天没有任务</view>
      </view>
    </scroll-view>
  </view>

  <view class="fab" bind:tap="onAddTask">+</view>

  <quick-add
    open="{{quickAddOpen}}"
    defaultDate="{{selected}}"
    bind:close="onQuickAddClose"
    bind:created="onQuickAddCreated"
  />

  <view class="ts-mask" wx:if="{{detail}}" bind:tap="onCloseDetail">
    <view class="ts" catch:tap="noop">
      <view class="ts__grip"></view>
      <scroll-view scroll-y class="ts__scroll" style="max-height: 62vh;">
        <view class="ts__chips">
          <view class="ts__chip {{detail.isInbox ? 'ts__chip--inbox' : ''}}">{{detail.goalTitle}}</view>
          <view class="ts__chip {{detail.priority === 'low' ? 'ts__chip--prio-low' : 'ts__chip--prio'}}" wx:if="{{!detail.isInbox && detail.priorityLabel}}">{{detail.priorityLabel}}</view>
        </view>
        <view class="ts__title">{{detail.name}}</view>

        <block wx:if="{{detail.isInbox}}">
          <view class="ts__meta" wx:if="{{detail.plannedDate}}">
            <text class="ts__meta-k">安排日期</text>
            <text class="ts__meta-v">{{detail.plannedDate}}</text>
          </view>
        </block>

        <block wx:else>
          <view class="ts__stage" wx:if="{{detail.stageNo}}">
            <view class="ts__stage-top">
              <text class="ts__stage-lab">所属阶段</text>
              <text class="ts__stage-frac">{{detail.stageNo}} / {{detail.stageTotal}}</text>
            </view>
            <view class="ts__stage-name">{{detail.stageName}}</view>
            <view class="ts__stage-track">
              <view class="ts__stage-fill" style="width: {{detail.stagePct}}%;"></view>
            </view>
          </view>

          <view class="ts__sec">
            <view class="ts__sec-lab"><view class="ts__sec-dot"></view>学习内容</view>
            <view class="ts__learn" wx:if="{{detail.learnContent}}">{{detail.learnContent}}</view>
          </view>

          <view class="ts__sec">
            <view class="ts__sec-lab"><view class="ts__sec-dot"></view>学习材料</view>
            <block wx:if="{{detail.resources.length}}">
              <view
                class="ts__mat"
                wx:for="{{detail.resources}}"
                wx:key="title"
                data-index="{{index}}"
                bind:tap="onOpenResource"
              >
                <view class="ts__mat-ico">材</view>
                <view class="ts__mat-body">
                  <text class="ts__mat-title">{{item.title}}</text>
                  <text class="ts__mat-note" wx:if="{{item.origin}}">出处 · {{item.origin}}</text>
                  <text class="ts__mat-note" wx:elif="{{item.note}}">{{item.note}}</text>
                </view>
                <view class="ts__mat-btn">查看</view>
              </view>
            </block>
            <view class="ts__empty" wx:else>暂无学习材料</view>
          </view>
        </block>
      </scroll-view>
      <view class="ts__foot">
        <view class="ts__btn ts__btn--ghost" bind:tap="onCloseDetail">关闭</view>
        <view
          class="ts__btn {{detail.status === 'done' ? 'ts__btn--done' : 'ts__btn--primary'}}"
          data-id="{{detail.id}}"
          bind:tap="onToggleFromDetail"
        >{{detail.status === 'done' ? '已完成' : '标记完成'}}</view>
      </view>
    </view>
  </view>

  <view class="rd-mask" wx:if="{{matDetail}}" bind:tap="onCloseMat" catchtouchmove="noop">
    <view class="rd" catch:tap="noop">
      <view class="rd__grip"></view>
      <view class="rd__bar">
        <text class="rd__type">{{matDetail.typeLabel}}</text>
        <text class="rd__x" bind:tap="onCloseMat">关闭</text>
      </view>
      <view class="rd__title">{{matDetail.title}}</view>
      <view class="rd__sec">
        <view class="rd__lab">出处</view>
        <view class="rd__body">{{matDetail.origin}}</view>
      </view>
      <view class="rd__sec">
        <view class="rd__lab">怎么找到</view>
        <view class="rd__body">{{matDetail.howtoFind}}</view>
      </view>
      <view class="rd__sec">
        <view class="rd__lab">学习说明</view>
        <view class="rd__body">{{matDetail.content}}</view>
      </view>
      <view class="rd__ops">
        <view class="rd__btn rd__btn--ghost" bind:tap="onCloseMat">关闭</view>
        <view
          class="rd__btn"
          wx:if="{{matDetail.url}}"
          data-url="{{matDetail.url}}"
          bind:tap="onCopyResource"
        >复制链接</view>
        <view
          class="rd__btn"
          wx:else
          data-text="{{matDetail.howtoFind}}"
          bind:tap="onCopyHowto"
        >复制查找方式</view>
      </view>
    </view>
  </view>
</view>
