.hero {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.tabs {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.tab {
  padding: 12rpx 0 16rpx;
  color: var(--ink-3);
  font-size: 28rpx;
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
}

.tab--on {
  color: var(--accent);
  font-weight: 600;
  border-bottom-color: var(--accent);
}

.skill {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.skill__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.skill__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
}

.skill__lv {
  font-size: 22rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.ops {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
}

.link {
  color: var(--accent);
  font-size: 26rpx;
}

.link--warn {
  color: var(--down);
}

.domain {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.domain__top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.domain__name {
  font-size: 30rpx;
  font-weight: 600;
}

.nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 12rpx;
}

.node {
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 4rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.empty {
  padding: 24rpx 0;
}

.line {
  padding: 8rpx 0;
}
