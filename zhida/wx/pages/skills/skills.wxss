/* 技能档案 · 安静列表：只露名称，点开看细节 */

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.top__title {
  font-size: 44rpx;
  font-weight: 720;
  letter-spacing: -0.03em;
  color: var(--ink-1);
}

.top__actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.top__add {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.top__add--press {
  opacity: 0.88;
}

.top__more {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.top__more--press {
  color: var(--ink-2);
}

.tabs {
  display: flex;
  gap: 28rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.tab {
  padding: 14rpx 0 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.tab--on {
  color: var(--ink-1);
  font-weight: 650;
  border-bottom-color: var(--accent);
}

.filters {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.filter {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.filter--on {
  background: rgba(126, 196, 192, 0.12);
  color: var(--accent);
  font-weight: 650;
}

.sec {
  margin-top: 20rpx;
}

.sec__lab {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.08em;
  margin-bottom: 4rpx;
  padding: 8rpx 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.row--press {
  opacity: 0.65;
}

.row__name {
  font-size: 34rpx;
  font-weight: 620;
  color: var(--ink-1);
  letter-spacing: -0.02em;
  line-height: 1.3;
}

.row__go {
  flex-shrink: 0;
  font-size: 34rpx;
  color: rgba(111, 127, 125, 0.55);
  line-height: 1;
}

.void {
  padding: 80rpx 12rpx 40rpx;
  text-align: center;
}

.void__title {
  font-size: 30rpx;
  font-weight: 620;
  color: var(--ink-1);
  margin-bottom: 10rpx;
}

.void__hint {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.45;
}

.graph-card {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.graph-card__name {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}

.graph-card__nodes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.graph-node {
  font-size: 28rpx;
  color: var(--ink-1);
  font-weight: 560;
}

/* 详情底栏 */
.sd-mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(8, 12, 14, 0.64);
  display: flex;
  align-items: flex-end;
}

.sd {
  width: 100%;
  max-height: 76vh;
  overflow-y: auto;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #222a2c 0%, #1a2123 30%);
  padding: 0 32rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sd__grip {
  width: 56rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.16);
}

.sd__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0 6rpx;
}

.sd__domain {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 650;
}

.sd__x {
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 8rpx 0;
}

.sd__name {
  font-size: 44rpx;
  font-weight: 720;
  color: var(--ink-1);
  letter-spacing: -0.03em;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.sd__level {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 20rpx;
}

.sd__goals {
  margin-bottom: 20rpx;
}

.sd__lab {
  display: block;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
  letter-spacing: 0.04em;
}

.sd__goal {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.sd__ops {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.sd__btn {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 26rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sd__btn--ghost {
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--border);
}

.sd__sec {
  border-top: 1rpx solid var(--border);
  padding-top: 8rpx;
}

.sd__mod {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.sd__mod:last-child {
  border-bottom: none;
}

.sd__mod-name {
  display: block;
  font-size: 28rpx;
  color: var(--ink-1);
  font-weight: 560;
  line-height: 1.35;
  margin-bottom: 8rpx;
}

.sd__mod-ops {
  display: flex;
  gap: 28rpx;
}

.sd__empty {
  margin-top: 8rpx;
  padding: 28rpx 0;
  font-size: 24rpx;
  color: var(--ink-3);
}

.link {
  color: var(--accent);
  font-size: 24rpx;
}

.link--warn {
  color: var(--down);
}
