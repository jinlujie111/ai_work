.hero {
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.plan {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.plan__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.plan__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-1);
  margin-bottom: 6rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent-2);
  flex-shrink: 0;
}

.tip {
  margin-top: 24rpx;
}
