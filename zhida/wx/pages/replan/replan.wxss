.reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}

.reason {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  color: var(--ink-2);
  font-size: 24rpx;
  border: 1rpx solid transparent;
}

.reason--on {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: rgba(23, 108, 107, 0.25);
}

.area {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--panel-2);
  border-radius: var(--r-sm);
  border: 1rpx solid var(--border);
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.diff {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border);
}

.diff__name {
  color: var(--ink-1);
  margin-bottom: 4rpx;
}
