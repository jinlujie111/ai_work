.market {
  padding-bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 40rpx);
}

.head {
  margin-bottom: 24rpx;
}

.head__title {
  font-size: 48rpx;
  font-weight: 680;
  letter-spacing: -0.03em;
  color: var(--ink-1);
}



.search {
  margin-bottom: 20rpx;
}

.search__input {
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  color: var(--ink-1);
  font-size: 28rpx;
}

.domains {
  white-space: nowrap;
  margin-bottom: 24rpx;
  padding-bottom: 4rpx;
}

.dom {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  color: var(--ink-3);
  font-size: 24rpx;
  vertical-align: top;
}

.dom__lab {
  line-height: 1;
}

.dom__n {
  min-width: 28rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.08);
  color: var(--ink-3);
  font-size: 18rpx;
  text-align: center;
}

.dom--on {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.dom--on .dom__n {
  background: rgba(126, 196, 192, 0.22);
  color: var(--accent);
}

.card {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 24rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card__title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 650;
  color: var(--ink-1);
}

.card__tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
}

.card__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.card__overview {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card__foot {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card__link {
  font-size: 24rpx;
  color: var(--ink-3);
}

.card__btn {
  margin: 0;
  background: var(--accent) !important;
  color: var(--on-accent) !important;
  border-radius: 999rpx !important;
  font-size: 24rpx !important;
  padding: 0 28rpx !important;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty__title {
  font-size: 30rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}


