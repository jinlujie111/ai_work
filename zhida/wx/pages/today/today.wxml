<view class="page overview">
  <view class="head">
    <view class="head__title">概览</view>
  </view>

  <view class="card week" bind:tap="onOpenCalendar">
    <view class="card__top">
      <view class="card__title">每周报告</view>
      <view class="card__stat">
        <text class="card__n">{{weekCount}}</text>
        <text class="card__unit">项</text>
        <text class="card__sub">接下来 7 天</text>
      </view>
    </view>
    <view class="wave" wx:if="{{weekDays.length}}">
      <view class="wave__track">
        <view class="wave__col" wx:for="{{weekDays}}" wx:key="date">
          <view class="wave__stem">
            <view class="wave__fill {{item.isToday ? 'wave__fill--on' : ''}}" style="height: {{item.barHeight}}%;"></view>
          </view>
          <text class="wave__lab {{item.isToday ? 'wave__lab--on' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="card__empty" wx:else>本周暂无安排</view>
    <view class="card__foot">
      <text>打开日历</text>
      <text class="card__arrow">›</text>
    </view>
  </view>

  <view class="sec">
    <view class="sec__title">今天</view>
    <view class="sec__date">{{fullDate}}</view>
  </view>

  <view class="card list">
    <view class="list__head">
      <view class="list__left">
        <view class="pill-n" wx:if="{{totalCount}}">{{totalCount}}</view>
        <view class="pill">待办</view>
      </view>
      <text class="list__add" bind:tap="onAddTask">+ 新任务</text>
    </view>

    <block wx:if="{{tasks.length}}">
      <view
        class="row {{item.status === 'done' ? 'row--done' : ''}}"
        wx:for="{{tasks}}"
        wx:key="id"
      >
        <view
          class="check {{item.status === 'done' ? 'check--on' : ''}}"
          data-id="{{item.id}}"
          catch:tap="onToggle"
        ></view>
        <view class="row__main" data-id="{{item.id}}" bind:tap="onOpenTask">
          <view class="row__cat">
            <text>{{item.goalTitle}}</text>
            <text class="prio-tag prio-tag--{{item.priority}}" wx:if="{{item.priorityLabel}}">{{item.priorityLabel}}</text>
          </view>
          <view class="row__name">{{item.name}}</view>
          <view class="row__mins" wx:if="{{!item.isInbox}}">
            <text wx:if="{{item.stageNo}}">第 {{item.stageNo}}/{{item.stageTotal}} 阶段 · </text>
            {{item.estimatedMinutes}} 分
          </view>
          <view class="row__mins" wx:else>快速待办</view>
        </view>
        <view class="row__more" wx:if="{{item.status !== 'done'}}" data-id="{{item.id}}" catch:tap="onMore">···</view>
      </view>
    </block>

    <view class="void" wx:else>
      <view class="void__orb"></view>
      <view class="void__title">今天没有任务</view>
      <view class="void__cta" bind:tap="onAddTask">+ 新任务</view>
    </view>
  </view>

  <view class="fab" bind:tap="onAddTask">+</view>

  <quick-add
    open="{{quickAddOpen}}"
    defaultDate="{{today}}"
    bind:close="onQuickAddClose"
    bind:created="onQuickAddCreated"
  />

  <view class="ts-mask" wx:if="{{detail}}" bind:tap="onCloseDetail">
    <view class="ts" catch:tap="noop">
      <view class="ts__grip"></view>
      <scroll-view scroll-y class="ts__scroll" style="max-height: 62vh;">
        <view class="ts__chips">
          <view class="ts__chip {{detail.isInbox ? 'ts__chip--inbox' : ''}}">{{detail.goalTitle}}</view>
          <view class="ts__chip {{detail.priority === 'low' ? 'ts__chip--prio-low' : 'ts__chip--prio'}}" wx:if="{{!detail.isInbox && detail.priorityLabel}}">{{detail.priorityLabel}}</view>
        </view>
        <view class="ts__title">{{detail.name}}</view>

        <block wx:if="{{detail.isInbox}}">
          <view class="ts__meta" wx:if="{{detail.plannedDate}}">
            <text class="ts__meta-k">安排日期</text>
            <text class="ts__meta-v">{{detail.plannedDate}}</text>
          </view>
        </block>

        <block wx:else>
          <view class="ts__stage" wx:if="{{detail.stageNo}}">
            <view class="ts__stage-top">
              <text class="ts__stage-lab">所属阶段</text>
              <text class="ts__stage-frac">{{detail.stageNo}} / {{detail.stageTotal}}</text>
            </view>
            <view class="ts__stage-name">{{detail.stageName}}</view>
            <view class="ts__stage-track">
              <view class="ts__stage-fill" style="width: {{detail.stagePct}}%;"></view>
            </view>
          </view>

          <view class="ts__sec">
            <view class="ts__sec-lab"><view class="ts__sec-dot"></view>学习内容</view>
            <view class="ts__learn" wx:if="{{detail.learnContent}}">{{detail.learnContent}}</view>
          </view>

          <view class="ts__sec">
            <view class="ts__sec-lab"><view class="ts__sec-dot"></view>学习材料</view>
            <block wx:if="{{detail.resources.length}}">
              <view class="ts__mat" wx:for="{{detail.resources}}" wx:key="title">
                <view class="ts__mat-ico">材</view>
                <view class="ts__mat-body">
                  <text class="ts__mat-title">{{item.title}}</text>
                  <text class="ts__mat-note" wx:if="{{item.note}}">{{item.note}}</text>
                </view>
                <view
                  class="ts__mat-btn {{item.url ? '' : 'ts__mat-btn--ghost'}}"
                  data-url="{{item.url}}"
                  catch:tap="onCopyResource"
                >{{item.url ? '复制' : '无链接'}}</view>
              </view>
            </block>
            <view class="ts__empty" wx:else>暂无链接材料</view>
          </view>
        </block>
      </scroll-view>
      <view class="ts__foot">
        <view class="ts__btn ts__btn--ghost" bind:tap="onCloseDetail">关闭</view>
        <view
          class="ts__btn {{detail.status === 'done' ? 'ts__btn--done' : 'ts__btn--primary'}}"
          data-id="{{detail.id}}"
          bind:tap="onToggleFromDetail"
        >{{detail.status === 'done' ? '已完成' : '标记完成'}}</view>
      </view>
    </view>
  </view>
</view>
