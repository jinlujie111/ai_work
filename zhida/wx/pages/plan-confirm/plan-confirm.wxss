.confirm {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.4;
}

.step--on,
.step--done {
  opacity: 1;
}

.step__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--ink-3);
}

.step--on .step__dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--accent);
  box-shadow: 0 0 0 8rpx var(--accent-soft);
}

.step--done .step__dot {
  background: var(--accent);
}

.step__lab {
  font-size: 20rpx;
  color: var(--ink-3);
}

.step--on .step__lab {
  color: var(--accent);
  font-weight: 600;
}

.step__line {
  width: 56rpx;
  height: 2rpx;
  margin-bottom: 28rpx;
  background: var(--border);
}

.card {
  background: var(--bg);
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.hero__title {
  font-size: 40rpx;
  font-weight: 650;
  letter-spacing: -0.03em;
  color: var(--ink-1);
  margin-bottom: 12rpx;
}

.hero__meta,
.hero__base {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.hero__base {
  margin-top: 10rpx;
  color: var(--ink-2);
}

.card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.card__no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
}

.card__meta {
  font-size: 22rpx;
  color: var(--ink-3);
}

.card__body {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.65;
}

.scene {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border);
}

.scene:first-of-type {
  border-top: none;
  padding-top: 0;
}

.scene__dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.scene__text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.card__actions {
  display: flex;
  gap: 28rpx;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border);
}

.mod {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border);
}

.mod:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}

.mod__idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--panel-2);
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mod--on .mod__idx {
  background: var(--accent-soft);
  color: var(--accent);
}

.mod__body {
  flex: 1;
  min-width: 0;
}

.mod__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.mod__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
  flex: 1;
}

.mod--on .mod__name {
  color: var(--accent);
}

.mod__diff {
  font-size: 20rpx;
  color: var(--ink-3);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
}

.mod__learn {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.mod__skills {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.mats {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: var(--panel-2);
}

.mats__lab {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.mat {
  padding: 8rpx 0;
}

.mat__title {
  display: block;
  font-size: 24rpx;
  color: var(--ink-1);
}

.mat__note {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.mat__link {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--accent);
}



.prio {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.prio:last-child {
  border-bottom: none;
}

.prio__rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.prio__body {
  flex: 1;
  min-width: 0;
}

.prio__title {
  font-size: 28rpx;
  color: var(--ink-1);
  font-weight: 560;
}

.prio__tag {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--accent);
}

.prio__ops {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.prio__btn {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  font-size: 22rpx;
  color: var(--ink-2);
}

.prio__btn--off {
  opacity: 0.28;
  pointer-events: none;
}

.mod__skip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.mod__check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 238, 236, 0.28);
  box-sizing: border-box;
  flex-shrink: 0;
}

.mod__check--on {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: inset 0 0 0 7rpx var(--bg);
}

.link {
  font-size: 24rpx;
  color: var(--accent);
}

.foot-space {
  height: 24rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(16, 20, 22, 0.94);
  border-top: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.dock__btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: 24rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.dock__btn::after {
  border: none;
}

.dock__ghost {
  padding: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.stream-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(8, 12, 14, 0.72);
}

.stream-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(165deg, rgba(28, 38, 40, 0.98), rgba(18, 24, 26, 0.98));
  border: 1rpx solid rgba(126, 196, 192, 0.18);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
}

.stream-modal__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 16rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  background: rgba(126, 196, 192, 0.16);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.stream-modal__title {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--ink-1);
  line-height: 1.4;
  margin-bottom: 28rpx;
  min-height: 88rpx;
}

.stream-modal__bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.1);
  overflow: hidden;
  margin-bottom: 16rpx;
}

.stream-modal__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(126, 196, 192, 0.45), var(--accent));
  transition: width 0.25s ease;
}

.stream-modal__meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--accent);
  margin-bottom: 20rpx;
}

.stream-modal__logs {
  max-height: 220rpx;
  overflow: hidden;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.22);
  margin-bottom: 18rpx;
}

.stream-modal__log {
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.55;
  padding: 2rpx 0;
}

.card__hint {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.5;
  margin: 0 0 16rpx;
}

.prev {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  opacity: 0.55;
}

.prev--on {
  opacity: 1;
}

.prev__date {
  min-width: 150rpx;
  font-size: 22rpx;
  color: var(--accent);
  padding-top: 4rpx;
}

.prev__body {
  flex: 1;
  min-width: 0;
}

.prev__name {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.4;
}

.prev__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.prev__done {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.45;
}

.prev__check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--ink-3);
  margin-top: 6rpx;
  flex-shrink: 0;
}

.prev__check--on {
  background: var(--accent);
  border-color: var(--accent);
}


