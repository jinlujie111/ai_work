/* Night Teal · isolated tokens · no native <button> */

.qa-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(8, 12, 14, 0.64);
  display: flex;
  align-items: flex-end;
}

.qa {
  width: 100%;
  box-sizing: border-box;
  border-radius: 40rpx 40rpx 0 0;
  background: linear-gradient(180deg, #232b2d 0%, #1a2123 32%);
  box-shadow: 0 -24rpx 64rpx rgba(0, 0, 0, 0.45);
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.qa__grip {
  width: 64rpx;
  height: 8rpx;
  margin: 18rpx auto 0;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.18);
}

.qa__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 4rpx;
}

.qa__badge {
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(126, 196, 192, 0.16);
  border: 1rpx solid rgba(126, 196, 192, 0.3);
  color: #7ec4c0;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
}

.qa__x {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.06);
  color: #6f7f7d;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa__x--press {
  background: rgba(232, 238, 236, 0.12);
}

.qa__compose {
  display: block;
  width: auto;
  min-height: 96rpx;
  margin: 8rpx 32rpx 0;
  padding: 12rpx 0 28rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(232, 238, 236, 0.1);
  border-radius: 0;
  color: #eef3f1;
  font-size: 40rpx;
  font-weight: 620;
  line-height: 1.35;
  letter-spacing: -0.03em;
}

.qa__compose-ph {
  color: #6f7f7d;
  font-weight: 450;
  letter-spacing: 0;
}

.qa__dates {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 28rpx 32rpx 8rpx;
}

.qa__pill {
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #222a2c;
  border: 1rpx solid rgba(232, 238, 236, 0.1);
  color: #a8b5b3;
  font-size: 26rpx;
  font-weight: 560;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qa__pill--cal {
  gap: 10rpx;
  max-width: 100%;
}

.qa__cal-ico {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  background: rgba(126, 196, 192, 0.16);
  color: #7ec4c0;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.qa__pill--on {
  background: rgba(126, 196, 192, 0.18);
  border-color: rgba(126, 196, 192, 0.42);
  color: #7ec4c0;
  font-weight: 650;
}

.qa__pill--press {
  opacity: 0.82;
}

.qa__bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 18rpx 32rpx 22rpx;
  border-top: 1rpx solid rgba(232, 238, 236, 0.08);
  background: rgba(22, 28, 30, 0.94);
}

.qa__ghost {
  flex: 0 0 168rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #222a2c;
  border: 1rpx solid rgba(232, 238, 236, 0.1);
  color: #a8b5b3;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qa__ghost--press {
  background: #2a3335;
}

.qa__go {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #7ec4c0;
  color: #0f1617;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 32rpx rgba(126, 196, 192, 0.28);
}

.qa__go--press {
  opacity: 0.9;
  transform: scale(0.985);
}

.qa__go--dim {
  opacity: 0.42;
  box-shadow: none;
}
