/** 学习者 · Night Teal desk（深色桌面感，对标执行台质感） */
page {
  --page: #101416;
  --bg: #1a2123;
  --panel-2: #222a2c;
  --border: rgba(232, 238, 236, 0.08);
  --ink-1: #eef3f1;
  --ink-2: #a8b5b3;
  --ink-3: #6f7f7d;
  --accent: #7ec4c0;
  --accent-2: #d4896a;
  --accent-soft: rgba(126, 196, 192, 0.16);
  --on-accent: #0f1617;
  --up: #6fbf9a;
  --down: #e07a72;
  --warn: #d4a24c;
  --r: 28rpx;
  --r-sm: 18rpx;
  --space: 28rpx;
  --tab-h: 112rpx;
  --shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.35);

  background: var(--page);
  color: var(--ink-1);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

.page {
  min-height: 100vh;
  padding: var(--space);
  padding-bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

.page--plain {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.zd-card {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0 0 28rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.zd-card--soft {
  background: var(--bg);
  border: none;
  border-radius: var(--r);
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-bottom: none;
  box-shadow: var(--shadow);
}

.zd-sec {
  margin-bottom: 36rpx;
}

.zd-sec__head {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-1);
  margin-bottom: 12rpx;
}

.zd-sec__hint {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
  line-height: 1.45;
}

.zd-title {
  font-size: 40rpx;
  font-weight: 650;
  color: var(--ink-1);
  margin-bottom: 10rpx;
  letter-spacing: -0.03em;
}

.zd-kicker {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.zd-muted {
  color: var(--ink-3);
  font-size: 24rpx;
}

.zd-chev {
  color: var(--ink-3);
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

.zd-body {
  color: var(--ink-2);
  font-size: 28rpx;
}

.zd-row {
  display: flex;
  align-items: center;
}

.zd-row--between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.zd-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-sm);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1.2;
}

.zd-btn::after {
  border: none;
}

.zd-btn--primary {
  background: var(--accent);
  color: var(--on-accent);
}

.zd-btn--primary:active {
  opacity: 0.88;
}

.zd-btn--ghost {
  background: transparent;
  color: var(--accent);
  border: 1rpx solid rgba(126, 196, 192, 0.35);
}

.zd-btn--clay {
  background: var(--accent-2);
  color: var(--on-accent);
}

.zd-btn--block {
  width: 100%;
}

.zd-btn--sm {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.zd-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--ink-2);
  font-size: 22rpx;
  border: 1rpx solid var(--border);
}

.zd-chip--warn {
  border-color: rgba(212, 162, 76, 0.35);
  color: var(--warn);
}

.zd-empty {
  padding: 48rpx 8rpx;
  text-align: left;
  color: var(--ink-3);
  font-size: 26rpx;
}

.zd-fab-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.zd-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.zd-list-row:last-child {
  border-bottom: none;
}

/* 资料 · 学习文档底栏 */
.rd-mask {
  position: fixed;
  inset: 0;
  z-index: 10020;
  background: rgba(8, 12, 14, 0.64);
  display: flex;
  align-items: flex-end;
}

.rd {
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  box-sizing: border-box;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #222a2c 0%, #1a2123 30%);
  padding: 0 32rpx calc(28rpx + env(safe-area-inset-bottom));
}

.rd__grip {
  width: 56rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: rgba(232, 238, 236, 0.16);
}

.rd__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0 6rpx;
}

.rd__type {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 650;
}

.rd__x {
  font-size: 26rpx;
  color: var(--ink-3);
  padding: 8rpx 0;
}

.rd__title {
  font-size: 40rpx;
  font-weight: 720;
  color: var(--ink-1);
  letter-spacing: -0.03em;
  line-height: 1.25;
  margin-bottom: 8rpx;
}

.rd__stage {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
}

.rd__sec {
  margin-bottom: 22rpx;
}

.rd__lab {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
  letter-spacing: 0.04em;
}

.rd__body {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.65;
  white-space: pre-wrap;
}

.rd__note {
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.rd__ops {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.rd__btn {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 26rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rd__btn--ghost {
  background: transparent;
  color: var(--ink-2);
  border: 1rpx solid var(--border);
}
